# Expo inlines EXPO_PUBLIC_* into the JS bundle at build time.
# Anything here is readable by anyone with the app. Never put a secret in this file.

# Base URL of the Next.js API (apps/web). Use your LAN IP for a device on dev.
EXPO_PUBLIC_API_URL=http://localhost:3000

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_STREAM_API_KEY=xxx
EXPO_PUBLIC_SENTRY_DSN=
