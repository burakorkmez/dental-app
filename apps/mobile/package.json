  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.9",
    "eslint-config-expo": "~57.0.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@clerk/expo"
      ]
    },
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:ios": "npx eas-cli build --profile development --platform ios",
    "build:android": "npx eas-cli build --profile development --platform android"
  },
  "private": true,
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  }
